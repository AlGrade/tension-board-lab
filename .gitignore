.idea/
.venv/
.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
work/

# Board databases may contain account-derived or licensed data.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

checkpoints/*
!checkpoints/.gitkeep
*.env

# Web application: dependencies and build output.
web/node_modules/
web/dist/

# Exported artifacts. The handful the deployed app loads at runtime are committed, so the
# site can be built from a clone alone - they are model weights and board reference data,
# with nothing account-derived in them. Everything else stays out: the fp32 graphs are four
# times the size and only used by the local parity tests, and the fixtures and placement-id
# table are derived from the board database.
web/public/models/*
!web/public/models/grade.int8.onnx
!web/public/models/generator.int8.onnx
web/public/data/*
!web/public/data/board.json
!web/public/data/critic.json
!web/public/data/generator.json
