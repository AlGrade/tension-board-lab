{
  "name": "TB2 12x12 Grade Transformer",
  "board": "Tension Board 2",
  "training_sources": ["Mirror", "Spray"],
  "size": "12x12",
  "angles": [35, 40, 45, 50, 55],
  "angle_encoding": "continuous degrees plus sine/cosine",
  "grade_scale": "V0-V14",
  "training_target": {
    "source": "angle-specific unrounded community difficulty average",
    "encoding": "linear interpolation on the V-grade axis as soft class labels"
  },
  "model_inputs": [
    "hold_type",
    "orientation",
    "coordinates",
    "route_role",
    "wall_angle"
  ],
  "excluded_inputs": [
    "layout",
    "material",
    "left_right_variant",
    "placement_id",
    "climb_name",
    "ascents"
  ],
  "architecture": {
    "type": "geometry-biased graph transformer",
    "parameters": 2851263,
    "hold_types": 106,
    "width": 192,
    "attention_heads": 8,
    "transformer_layers": 6,
    "feed_forward_expansion": 4,
    "dropout": 0.12,
    "output_classes": 15
  },
  "output": ["predicted_grade", "calibrated_confidence"]
}
